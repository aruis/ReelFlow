          }
        }
      }
    },
    "%@\n失败阶段: %@\n建议动作: %@\n建议: %@\n日志: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@\n失败阶段: %2$@\n建议动作: %3$@\n建议: %4$@\n日志: %5$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nFailed stage: %@\nRecommended action: %@\nAdvice: %@\nLog: %@"
          }
        }
      }
    },
    "%@\n失败阶段: %@\n问题素材: %@\n处理建议: 在素材列表中定位该文件，替换或移除后重试导出\n建议动作: %@\n详细建议: %@\n日志: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@\n失败阶段: %2$@\n问题素材: %3$@\n处理建议: 在素材列表中定位该文件，替换或移除后重试导出\n建议动作: %4$@\n详细建议: %5$@\n日志: %6$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nFailed stage: %@\nProblem assets: %@\nSuggested fix: Locate the file in the asset list, then replace or remove it before retrying export\nRecommended action: %@\nDetailed advice: %@\nLog: %@"
          }
        }
      }
    },
